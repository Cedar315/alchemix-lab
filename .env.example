# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DATABASE?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side chat provider (agent, generation and evidence review)
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL="https://api.deepseek.com/chat/completions"
DEEPSEEK_MODEL="deepseek-flash"

# Comma-separated administrator emails. Prefer app_metadata.role=admin in production.
ADMIN_EMAILS=

# Runtime host
APP_URL="http://localhost:3003"

# RAG embeddings: full HTTPS /embeddings endpoint matching your provider region.
# Do not use NEXT_PUBLIC_ prefixes for secrets. Fixed 1024-dimensional index.
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_URL=
RAG_EMBEDDING_MODEL=text-embedding-v4
# Initial experimental threshold; calibrate on held-out questions.
RAG_MIN_SIMILARITY=0.5
# RAG generation/review uses DEEPSEEK_*; embeddings remain independent.
# Set these to the actual API and model enabled in your account before live testing.

# 用户知识问答与 Agent 共用配额，需部署 ai_request_leases 迁移
AI_REQUESTS_PER_MINUTE=6
AI_REQUESTS_PER_DAY=60
AI_CONCURRENT_REQUESTS=1

# RAG 证据不足时使用的联网检索，服务端专用；未配置时记录知识缺口。
# Web search uses DEEPSEEK_API_KEY via the Anthropic-compatible API.
KNOWLEDGE_SEARCH_PROVIDER=deepseek
# Optional alternative: KNOWLEDGE_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=

# Product console: trusted internal test accounts (never use NEXT_PUBLIC_).
TEST_EMAILS=
# Vercel cron authentication for daily 30-day conversation detail retention.
CRON_SECRET=
# Optional local release label; deployed versions use the deployment identity.
APP_RELEASE=

DEEPSEEK_SEARCH_MODEL=deepseek-flash

# Independent AI SDK prototype; keep disabled until explicitly testing.
AGENT_EXPERIMENT_ENABLED=false

# Default streaming assistant. Set legacy and redeploy to roll back the UI.
ASSISTANT_RUNTIME=sdk
