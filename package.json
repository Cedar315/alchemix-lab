{
  "name": "alchemix-lab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build --webpack",
    "postinstall": "prisma generate",
    "start": "next start -p 3001",
    "clean": "rm -rf .next dist",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "db:migrate:deploy": "prisma migrate deploy",
    "check": "npm run typecheck && npm run build",
    "test:rag": "tsx --test src/lib/knowledge/rag/rag.test.ts",
    "rag:status": "tsx scripts/rag.ts status",
    "rag:ingest": "tsx scripts/rag.ts ingest",
    "test:rag:live": "tsx scripts/rag.ts smoke",
    "test": "tsx --test src/lib/knowledge/rag/rag.test.ts src/lib/recommendations/beginner.test.ts src/lib/agent/agent.test.ts src/lib/auth/return-path.test.ts src/lib/agent/preparation.test.ts src/lib/agent/companion.test.ts src/lib/knowledge/review/review.test.ts",
    "test:agent": "tsx --test src/lib/agent/preparation.test.ts src/lib/agent/companion.test.ts",
    "eval:rag": "tsx scripts/evaluate.ts rag",
    "eval:agent": "tsx scripts/evaluate-companion.ts",
    "db:status": "tsx scripts/database.ts status",
    "db:deploy": "tsx scripts/database.ts deploy",
    "test:budget:live": "tsx scripts/check-budget.ts",
    "test:browser": "node scripts/check-companion-browser.mjs",
    "eval:agent:legacy": "tsx scripts/evaluate.ts agent",
    "eval:agent:preparation": "tsx scripts/evaluate-preparation.ts",
    "test:browser:preparation": "node scripts/browser-check.mjs",
    "test:knowledge": "tsx --test src/lib/knowledge/review/review.test.ts",
    "test:knowledge:live": "tsx scripts/check-knowledge-store.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@prisma/client": "^5.10.1",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "next": "^16.3.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^3.22.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "prisma": "^5.10.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
